# Backend
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=tg_session
SESSION_TTL_HOURS=24
COOKIE_SECURE=false

# Neon Postgres (from `neon deploy` / `neon env pull` into .env.local)
# DATABASE_URL=pooled connection for the Go API
# DATABASE_URL_UNPOOLED=direct connection for migrations
DATABASE_URL=postgres://trygiraffes:trygiraffes@localhost:5433/trygiraffes?sslmode=disable
DATABASE_URL_UNPOOLED=postgres://trygiraffes:trygiraffes@localhost:5433/trygiraffes?sslmode=disable

# Frontend server-side proxy target
API_INTERNAL_URL=http://localhost:8080
